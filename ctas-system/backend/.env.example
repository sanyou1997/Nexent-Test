# ===== 模型接入层（OpenAI 兼容协议，改地址即可切换 Provider）=====
# 演示用云端 DeepSeek（https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=
# 也可自定义任意 OpenAI 兼容服务（如本地 vLLM：http://localhost:8001/v1）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== Embedding（可选）=====
# 配置后启用云端稠密向量（如硅基流动 BGE-M3，有免费额度）；
# 不配置则使用内置本地字符 n-gram TF-IDF 检索，完全离线可用
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ===== RAG 参数 =====
RETRIEVE_TOP_K=5
# 拒答阈值：本地字符 n-gram 余弦经验值 0.08；启用 BGE-M3 稠密向量后建议 0.25~0.30
REFUSE_THRESHOLD=0.08

# 生产部署务必修改
SECRET_KEY=demo-secret-change-in-production-9f2c1

# ===== 跨域 =====
# 逗号分隔；生产部署填实际前端域名，如 https://jiwei.example.gov.cn
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Nexent 智能体接入（北向 API）=====
# 推荐在「系统管理 → Nexent 接入」页面配置（保存在 data/nexent_settings.json，Key 不进版本库）；
# 以下环境变量仅作为页面未配置时的默认值。全系统共用一个 Key，会话归属由 CTAS 自行登记。
NEXENT_BASE_URL=http://127.0.0.1:5013
NEXENT_API_KEY=
NEXENT_DEFAULT_AGENT=
NEXENT_TIMEOUT=600
