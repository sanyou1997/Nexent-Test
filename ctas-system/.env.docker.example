# 复制为 ctas-system/.env 后按需修改（docker compose 会自动读取同目录 .env）
CTAS_SECRET_KEY=请改为随机长字符串
CTAS_DB_PASSWORD=请改为随机长字符串
# 业务平台 MCP 服务令牌：在 Nexent 注册 ctas_tools MCP 时作为鉴权令牌填写
CTAS_MCP_TOKEN=请改为随机长字符串
# CTAS_BIND=0.0.0.0          # 允许内网其他机器访问时改为 0.0.0.0
# CTAS_PORT=8090        # 避开 Higress 控制台与 910B4 上 vLLM 模型服务常用的 8001–8005
# CTAS_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NEXENT_BASE_URL=http://nexent-northbound:5013
# 识别服务跟随 Nexent（执行 docker/nexent-readonly-role.sql 后填写）：
# NEXENT_DB_DSN=postgresql://ctas_reader:<强密码>@nexent-postgresql:5432/nexent
# 未跟随 Nexent 时的手动默认值：
# CTAS_OCR_PROVIDER=umi_ocr        # umi_ocr | paddle_ocr | paddle_layout
# CTAS_PDF_MODE=mineru             # mineru | page_ocr
# CTAS_ASR_PROVIDER=paraformer     # paraformer | qwen_asr
